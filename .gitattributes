# Normalize line endings in the repository, not in the working copy.
#
# `core.autocrlf` is a *local* setting, so two machines can disagree about the
# same file and each sees the other's version as wholly modified -- 58 files of
# pure noise on a checkout. Pinning it here makes the repository the single
# source of truth instead of whoever cloned it last.
#
# The working copy on Windows still gets CRLF for these types; only what is
# stored is fixed.

* text=auto

*.py    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf

# The Firefox manifest is read as JSON; a stray byte order mark or CRLF is not
# worth debugging at load time.
extension/manifest.json text eol=lf

# Generated or binary: never touched.
*.png   binary
*.ico   binary

# The downloaded IDX instance.zip archives under data/instance/ are kept in the
# repository as the record of what was actually fetched -- 1774 immutable files,
# ~210 MB, none of which Git can usefully diff. Stored as plain blobs they would
# make every clone carry 210 MB of payload, and a corrected archive would leave
# its superseded copy in history forever. LFS keeps the repository at
# pointer size and lets a clone skip the payload deliberately.
*.zip   filter=lfs diff=lfs merge=lfs -text
