# Konfigurasi lokal. Salin menjadi .env lalu isi sendiri.
# .env sudah masuk .gitignore dan tidak boleh di-commit.

# --- Bridge Firefox ---
FIREFOX_BRIDGE_URL=http://127.0.0.1:8765
FIREFOX_BRIDGE_TOKEN_FILE=

# --- Downloader ---
FIREFOX_BRIDGE_DOWNLOAD_DIR=

# --- Sumber daftar saham dari MariaDB (fase kedua) ---
# Host, port, dan user boleh disimpan di sini.
# Password TIDAK boleh ditulis di file ini kalau file akan di-share.
IDX_DB_HOST=127.0.0.1
IDX_DB_PORT=3306
IDX_DB_USER=
IDX_DB_NAME=
IDX_DB_PASSWORD=
